{
  "swagger": "2.0",
  "info": {
    "title": "Q-Orders API",
    "version": "1.0.0",
    "description": "Customer Assistance APIs"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/api/v1/assistance/request": {
      "post": {
        "description": "",
        "responses": {
          "201": {
            "description": "Created"
          }
        },
        "tags": [
          "Customer Assistance"
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "id",
                "guest_id",
                "table_id",
                "type"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "guest_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "table_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "WATER",
                    "BILL",
                    "WAITER"
                  ]
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "/api/v1/staff/assistance-requests": {
      "get": {
        "description": "",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "type": "integer",
            "minimum": 1
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "tags": [
          "Customer Assistance"
        ]
      }
    },
    "/api/v1/staff/assistance-requests/{id}": {
      "patch": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "uuid"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "RESOLVED"
                  ]
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "tags": [
          "Customer Assistance"
        ]
      }
    }
  }
